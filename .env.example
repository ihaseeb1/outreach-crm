# ---------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same values in Vercel.
# Never commit real values.
# ---------------------------------------------------------------------

# Public URL of the app. Used to build unsubscribe links and email footers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by cron jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Background jobs --------------------------------------------------
# Shared secret required by every /api/cron/* route.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me

# --- Encryption -------------------------------------------------------
# AES-256-GCM key for mailbox credentials at rest. Exactly 32 bytes, hex or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-me

# --- OAuth2 mailboxes (optional) --------------------------------------
# Only needed if you want to connect mailboxes without an app password.
# Register the redirect URI shown below with each provider.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/oauth/google/callback
# Scopes used: https://mail.google.com/ and userinfo.email
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Azure Portal -> App registrations -> your app
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/oauth/microsoft/callback
# Delegated permissions: SMTP.Send, IMAP.AccessAsUser.All, offline_access, User.Read
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# "common" for any tenant, or your specific tenant id.
MICROSOFT_TENANT_ID=common

# --- Scraper ----------------------------------------------------------
# Descriptive UA so site owners can identify and contact you (politeness rule).
SCRAPER_USER_AGENT=OutreachCRM/1.0 (+https://example.com/bot; contact@example.com)
# Milliseconds to wait between requests to the same host.
SCRAPER_CRAWL_DELAY_MS=1500
# Max pages fetched per website (homepage + contact-ish pages).
SCRAPER_MAX_PAGES_PER_SITE=5
# Comma-separated extra disposable domains, on top of the built-in blocklist.
DISPOSABLE_DOMAINS_EXTRA=

# --- Dynamic scrape worker (optional, not used by the web app) --------
# Only read by scripts/scrape-worker.ts on a long-lived machine.
WORKER_BATCH_SIZE=5
WORKER_IDLE_DELAY_MS=30000
